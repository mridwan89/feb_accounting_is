# Salin menjadi .env lalu sesuaikan. Variabel yang sudah ada di lingkungan sistem tidak ditimpa.
PORT=3000
HOST=0.0.0.0

# Basis data MariaDB (akun aplikasi, bukan akun root)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=siapkas
DB_PASSWORD=ganti-dengan-kata-sandi-kuat
DB_NAME=sia_pengeluaran
# DB_POOL=20

# Folder penyimpanan (relatif terhadap folder server)
LAMPIRAN_DIR=data/lampiran
UPDATES_DIR=data/pembaruan
CLIENT_DIST=../client/dist

# HTTPS di LAN: isi jalur sertifikat dan kunci dari CA internal
# TLS_CERT=sertifikat/server.crt
# TLS_KEY=sertifikat/server.key

# Kata sandi awal akun admin saat migrasi pertama (wajib diganti saat masuk)
# ADMIN_PASSWORD_AWAL=Admin12345

# 0 untuk mematikan log setiap permintaan HTTP
LOG_REQUEST=1
